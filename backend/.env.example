APP_NAME=Smart City AI Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
AGENT_EXECUTION_TIMEOUT_SECONDS=10
CHAT_MAX_MESSAGE_LENGTH=5000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
AUTH_ENABLED=false
JWT_ISSUER=smart-city-ai
JWT_AUDIENCE=smart-city-ai-api

CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
