APP_NAME=Smart City AI Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
AGENT_EXECUTION_TIMEOUT_SECONDS=10
CHAT_MAX_MESSAGE_LENGTH=5000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

DATABASE_URL=postgresql+asyncpg://smart_city_app:change_me@localhost:5432/smart_city_ai
TEST_DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ENABLED=false
JWT_ISSUER=smart-city-ai
JWT_AUDIENCE=smart-city-ai-api
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_QUERY_MAX_LENGTH=500
WEB_SEARCH_ON_PARTIAL_FAILURE=true

NLP_ENABLED=true
NLP_SPACY_MODEL=en_core_web_sm
NLP_LOCAL_CONFIDENCE_THRESHOLD=0.80
NLP_GEMINI_FALLBACK_ENABLED=true

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
