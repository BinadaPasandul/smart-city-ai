# Base URL of the backend API, including its version prefix.
# Matches backend/app/core/config.py's API_V1_PREFIX (default /api/v1).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Display name used in the UI shell.
VITE_APP_NAME=CIVA

# The backend may later require `Authorization: Bearer <JWT>` once
# AUTH_ENABLED=true is set on the backend. No frontend auth UI exists yet;
# this is a placeholder so the variable is documented when that lands.
# VITE_AUTH_ENABLED=false
